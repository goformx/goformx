{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.goformx.com/contracts/auth/first-party-assertion.claims.v1.schema.json",
  "title": "GoFormX first-party assertion claims v1",
  "type": "object",
  "required": ["iss", "aud", "sub", "org", "scp", "iat", "nbf", "exp", "jti", "rid", "ver"],
  "additionalProperties": false,
  "properties": {
    "iss": { "const": "https://goformx.com" },
    "aud": { "const": "https://api.goformx.com" },
    "sub": { "type": "string", "format": "uuid" },
    "org": { "type": "string", "format": "uuid" },
    "scp": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "forms:read",
          "forms:write",
          "forms:publish",
          "submissions:read",
          "tokens:read",
          "tokens:write",
          "webhooks:read",
          "webhooks:write"
        ]
      }
    },
    "iat": { "type": "integer", "minimum": 0 },
    "nbf": { "type": "integer", "minimum": 0 },
    "exp": { "type": "integer", "minimum": 0 },
    "jti": { "type": "string", "format": "uuid" },
    "rid": { "type": "string", "format": "uuid" },
    "ver": { "const": 1 }
  }
}
