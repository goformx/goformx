# Supported schema-first GoFormX API configuration.
APP_NAME=GoFormX
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_SCHEME=http
APP_HOST=0.0.0.0
APP_PORT=8090

DB_DRIVER=postgres
DB_HOST=postgres-dev
DB_PORT=5432
DB_NAME=goforms
DB_USERNAME=goforms
DB_PASSWORD=
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_RPS=100
SECURITY_RATE_LIMIT_BURST=200
SECURITY_RATE_LIMIT_PUBLIC_SUBMISSION_RPS=1
SECURITY_RATE_LIMIT_PUBLIC_SUBMISSION_BURST=10
SECURITY_RATE_LIMIT_SUBMISSIONS_PER_DAY=1000

# Waaseyaa server-to-server assertions. The snapshot contains public keys only.
FIRST_PARTY_ASSERTION_ENABLED=false
FIRST_PARTY_ASSERTION_ISSUER=https://goformx.com
FIRST_PARTY_ASSERTION_AUDIENCE=https://api.goformx.com
FIRST_PARTY_ASSERTION_JWKS_URL=https://goformx.com/.well-known/goformx-control-plane-jwks.json
FIRST_PARTY_ASSERTION_JWKS_SNAPSHOT=
FIRST_PARTY_ASSERTION_REFRESH_INTERVAL=30s

# Generate once with: openssl rand -base64 32
WEBHOOK_ENABLED=false
WEBHOOK_ENCRYPTION_KEY=
# Optional versioned keyring JSON object: {"key-id":"base64-encoded-32-byte-key"}.
# Keep WEBHOOK_ENCRYPTION_KEY for legacy reads until the rotation runbook permits removal.
WEBHOOK_ENCRYPTION_KEYRING=
WEBHOOK_ACTIVE_ENCRYPTION_KEY_ID=
WEBHOOK_POLL_INTERVAL=1s
WEBHOOK_REQUEST_TIMEOUT=10s
WEBHOOK_LOCK_TIMEOUT=30s
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_BASE=5s
WEBHOOK_BACKOFF_MAX=1h
